---
interface Letter {
  file: string
  frontmatter: {
    title: string
    date: string
  }
}

const letters = (
  Object.values(import.meta.glob('../../pages/letters/*.md', { eager: true })) as Letter[]
)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3)
---

<section id="letters" class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-8">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">
        给大家<span
          class="ml-2 text-lg before:mx-2 before:text-primary-950/70 before:content-['/'] before:dark:text-primary-200/70"
          >Newsletters</span
        >
      </h2>
      <div class="flex flex-col gap-2">
        {
          letters.map((letter) => {
            const url = letter.file.split('/').slice(-1)[0].replace('.md', '')
            const formattedDate = new Date(letter.frontmatter.date).toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
            return (
              <a
                href={`/letters/${url}`}
                class="flex gap-2 rounded-md px-4 py-2 transition-colors duration-300 hover:bg-primary-500/10 dark:hover:bg-primary-400/10 max-sm:flex-col sm:items-center"
              >
                <h3 class="flex-1 text-lg font-medium">{letter.frontmatter.title}</h3>
                <span class="text-sm text-primary-950/60 dark:text-primary-200/60">
                  {formattedDate}
                </span>
              </a>
            )
          })
        }
      </div>
    </div>
    <div class="mt-4 text-center">
      <a href="/letters" class="text-sm font-medium">查看更多...</a>
    </div>
  </div>
</section>
